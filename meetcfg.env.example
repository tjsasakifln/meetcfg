# Copie para meetcfg.env (na raiz do repo) e edite. Carregado por backend/run.sh.

USER_NAME=Tiago

# --- Contexto comercial ---
# SALES_CONTEXT_PATH=sales_context.md
# Contexto estruturado do lead da vez (CONFENGE_SALES_CONTEXT/1.0), opcional.
# Vazio = modo manual: só o sales_context.md. Veja fixtures/ e o README.
# SALES_CONTEXT_V1_PATH=

# --- Hand-raiser consumer (Warmbly → uma conversa). Rollback = false. ---
# HANDRAISER_CONSUMER_ENABLED=true
# HANDRAISER_MAX_PAYLOAD_BYTES=256000
# Coleção GET /confenge/sales-context nunca é dossiê. Item é action_id.
# WARMBLY_SALES_CONTEXT_URL=

# --- LLM: Codex CLI já logado nesta máquina. Nenhuma API key é usada. ---
CUSTOM_LLM_CMD=bin/codex_llm.sh
# CODEX_EFFORT=low          # low é o mais rápido aceito pelo modelo padrão
# CODEX_MODEL=              # vazio = modelo padrão do seu Codex
# SUGGEST_TIMEOUT_S=90

# --- Whisper local (faster-whisper). CPU por padrão: nenhuma GPU assumida. ---
# WHISPER_WARMUP=true       # false pula o preload (TestClient / CI)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
# WHISPER_BEAM_SIZE=1
# Com GPU NVIDIA disponível no WSL:
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# --- Cadência do copiloto ---
# SUGGEST_MIN_INTERVAL_S=15   # intervalo mínimo entre chamadas ao Codex
# SUGGEST_MIN_NEW_CHARS=20    # só conta fala NOVA do lead
# SUGGEST_TRANSCRIPT_CHARS=2500

# --- Servidor ---
# MEETCFG_HOST=0.0.0.0
# MEETCFG_PORT=5005

# --- Endpointing (VAD por energia) ---
# VAD_THRESHOLD=0.008
# ENDPOINT_SILENCE_MS=800

# --- Supressão de eco (voz do lead vazando do alto-falante para o mic) ---
# ECHO_SUPPRESS=true
